# Samrajya frontend config. Copy to .env.local.
# 1 = in-browser mock game (bots, 15 s epochs, no wallet funds needed). 0 = live devnet game.
NEXT_PUBLIC_MOCK=0
# Optional: mock epoch length in seconds (default 15).
NEXT_PUBLIC_MOCK_EPOCH_SECS=60
NEXT_PUBLIC_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_ER_RPC=https://devnet-as.magicblock.app
NEXT_PUBLIC_ER_WS=wss://devnet-as.magicblock.app
NEXT_PUBLIC_ER_VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57
NEXT_PUBLIC_VRF_QUEUE=5hBR571xnXppuCPveTrctfTU7tJLSN94nq7kv7FRK5Tc
# Deployed on devnet 2026-10-07.
NEXT_PUBLIC_PROGRAM_ID=Hn5L61gn5B9ETWbRBjJ6qnLU2NdWSDBaqXCfy7jwT7Ng
# Fallback war id, used only when the on-chain registry cannot be read (the app follows the newest war).
NEXT_PUBLIC_GAME_ID=1

# Kingdom chat (Supabase Realtime). Values for development live in app/.env (gitignored).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
